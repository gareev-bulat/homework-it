#include <bits/stdc++.h>
#include <queue>

using namespace std;
queue <pair<int, int» q;
pair <int, int> mp;
int L[51][51], n_col, n_row, n = 1, s_y, s_x, otv;
bool flag = true;

void Read(){
    ifstream input("lab.txt");
    input » n_row » n_col » s_y » s_x;
    for(int i = 0; i < n_row; i++){
        for(int j = 0; j < n_col; j++){
            input » L[i][j];
        }
    }
    L[s_y][s_x] = 1;
    q.emplace(s_y, s_x);
    
}
void Print(){
    for(int i = 0; i < n_row; i++){
        for(int j = 0; j < n_col; j++){
            cout « setw(5) « L[i][j] « " ";
        }
        cout « "\n";
    }
}
void ogo(int x, int y){
    if (L[x - 1][y]==-2||L[x + 1][y]==-2||L[x][y- 1]==-2||L[x][y+ 1]==-2) {flag = false; otv =L[x][y] + 1;}
    if(L[x - 1][y]==0) {L[x- 1][y]=L[x][y] + 1; q.emplace(x- 1, y);}
    if(L[x + 1][y]==0) {L[x+ 1][y]=L[x][y] + 1; q.emplace(x+ 1, y);}
    if(L[x][y- 1]==0) {L[x][y- 1]=L[x][y] + 1;q.emplace(x, y- 1);}
    if(L[x][y+ 1]==0) {L[x][y+ 1]=L[x][y] + 1;q.emplace(x, y+ 1);}
    q.pop();
}
void ogospodi(){
    int o=0;
    while(flag){
        while (!q.empty()){
            ogo(q.front().first, q.front().second);
        }
    }
}

void Print_otv(){
    cout « otv;
}

int main(){
    Read(); Print();
    cout « "\n";
    ogospodi(); Print();
    Print_otv();
    return 0;
}
